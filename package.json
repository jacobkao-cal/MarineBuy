{
  "name": "marine-buy",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Sailing jacket research and comparison site",
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch-path=server server/index.js",
    "build:pages": "node scripts/build-pages.mjs",
    "validate": "node server/validate.js",
    "test": "node server/validate.js && node --test tests/research.test.mjs tests/accounts.test.mjs tests/assistant.test.mjs tests/pages-build.test.mjs",
    "test:e2e": "node tests/likes.e2e.mjs",
    "test:research": "node --test tests/research.test.mjs",
    "test:assistant": "node --test tests/assistant.test.mjs"
  },
  "engines": {
    "node": ">=20.12"
  },
  "dependencies": {
    "@google/genai": "2.26.0",
    "express": "^4.21.2"
  }
}
