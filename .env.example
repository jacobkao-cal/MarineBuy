# Copy this file to .env and fill in your own values. Never commit .env.
# Get a key at https://aistudio.google.com/apikey . The key is used only by server/assistant.js.
GEMINI_API_KEY=your-gemini-api-key-here
# Optional. Defaults to gemini-3.8-flash (stable). See https://ai.google.dev/gemini-api/docs/models
GEMINI_MODEL=gemini-3.8-flash
# Optional. Port for the local server (default 3000).
# PORT=3000
